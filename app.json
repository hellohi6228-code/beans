{
  "expo": {
    "name": "Beans",
    "slug": "beans",
    "scheme": "beans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beans.sourcing",
      "infoPlist": {
        "NSCameraUsageDescription": "Beans uses your camera so you can photograph your coffee beans, your shop and your events.",
        "NSPhotoLibraryUsageDescription": "Beans needs access to your photos so you can upload pictures of your beans and your business."
      }
    },
    "android": {
      "package": "com.beans.sourcing",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/beans"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Beans needs access to your photos so you can upload pictures of your beans and your business.",
          "cameraPermission": "Beans uses your camera so you can photograph your coffee beans, your shop and your events."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F4"
        }
      ]
    ]
  }
}
